# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are safe in a browser bundle: the anon key is designed to be public
# and is constrained by row-level security. Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
